---
import '../styles/global.css';
import SEO from '../components/shared/SEO.astro';
import Header from '../components/shared/Header.astro';
import Footer from '../components/shared/Footer.astro';
import AccessibilityToolbar from '../components/shared/AccessibilityToolbar.astro';
interface Props {
  title: string;
  description: string;
  contentPage?: boolean;
  noIndex?: boolean;
}
const { contentPage = false } = Astro.props;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO {...Astro.props} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link
      rel="preload"
      href="/fonts/raleway-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      (() => {
        const modes = ['high', 'dark', 'inverted'];
        try {
          const raw = localStorage.getItem('a11y-plugin-prefs');
          if (!raw) return;
          const preferences = JSON.parse(raw);
          if (preferences?.version !== 1) return;
          const fontSize = preferences.fontSize;
          if (
            Number.isInteger(fontSize) &&
            fontSize >= -30 &&
            fontSize <= 50 &&
            fontSize % 10 === 0 &&
            fontSize !== 0
          )
            document.documentElement.style.fontSize = `${100 + fontSize}%`;
          if (modes.includes(preferences.contrast))
            document.documentElement.setAttribute(
              'data-a11y-contrast',
              preferences.contrast,
            );
          if (preferences.dyslexicFont === true)
            document.documentElement.setAttribute('data-a11y-dyslexic', '');
          const keyboardNav =
            typeof preferences.keyboardNav === 'boolean'
              ? preferences.keyboardNav
              : preferences.active;
          if (keyboardNav === true)
            document.documentElement.setAttribute(
              'data-a11y-keyboard-enabled',
              '',
            );
        } catch {
          // Invalid or blocked storage must never prevent the page from rendering.
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main
      id="main-content"
      class:list={{ 'content-page': contentPage }}
      tabindex="-1"
    >
      <slot />
    </main>
    <Footer />
    <AccessibilityToolbar />
  </body>
</html>
